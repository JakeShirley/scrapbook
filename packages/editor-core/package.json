{
  "name": "@scrapbook/editor-core",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./stickers": {
      "types": "./dist/stickers.d.ts",
      "import": "./dist/stickers.js",
      "default": "./dist/stickers.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm run generate:fonts && tsc -p tsconfig.json",
    "generate:fonts": "node scripts/generate-fonts.mjs",
    "test": "pnpm run generate:fonts && vitest run src",
    "typecheck": "pnpm run generate:fonts && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@iconify-json/noto": "^1.2.7",
    "@iconify-json/twemoji": "^1.2.5",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.3",
    "opentype.js": "^2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.9"
  }
}
