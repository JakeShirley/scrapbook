{
  "name": "@zakka/api",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/persistence/migrate.ts",
    "dev": "tsx watch src/index.ts",
    "openapi:check": "tsx src/openapi.ts > /dev/null",
    "openapi:print": "tsx src/openapi.ts",
    "start": "node dist/index.js",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.0.2",
    "@hono/zod-openapi": "1.4.0",
    "@zakka/api-contract": "workspace:*",
    "@zakka/config": "workspace:*",
    "@zakka/domain": "workspace:*",
    "@zakka/editor-core": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "hono": "4.12.19",
    "jpeg2000": "^1.1.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@zakka/test-utils": "workspace:*"
  }
}
