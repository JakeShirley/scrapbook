{
  "name": "@scrapbook/web",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -w run generate:changelog && tsc -p tsconfig.json && vite build",
    "dev": "pnpm -w run generate:changelog && vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "screenshots": "pnpm -w run generate:changelog && pnpm --filter @scrapbook/editor-core build && pnpm --filter @scrapbook/api-contract build && pnpm screenshots:capture",
    "screenshots:capture": "playwright test --config playwright.screenshots.config.ts",
    "typecheck": "pnpm -w run generate:changelog && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.73.8",
    "@fluentui/react-icons": "^2.0.326",
    "@scrapbook/api-contract": "workspace:*",
    "@scrapbook/editor-core": "workspace:*",
    "marked": "^18.0.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.15.1",
    "utif": "^3.1.0",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2"
  }
}
