{
  "name": "zakka",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/JakeShirley/scrapbook.git"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @zakka/api dev",
    "dev:web": "pnpm --filter @zakka/web dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "generate:changelog": "node scripts/generate-changelog.mjs",
    "lint": "biome lint .",
    "openapi:check": "pnpm --filter @zakka/api openapi:check",
    "release:preview": "semantic-release --dry-run --no-ci --plugins @semantic-release/commit-analyzer --plugins @semantic-release/release-notes-generator",
    "screenshots": "pnpm --filter @zakka/web screenshots",
    "screenshots:capture": "pnpm --filter @zakka/web screenshots:capture",
    "screenshots:compare": "tsx scripts/screenshots/compare-screenshots.ts",
    "screenshots:product": "tsx scripts/screenshots/capture-product-screenshots.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "25.8.0",
    "@types/pngjs": "^6.0.5",
    "conventional-changelog": "^7.2.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "semantic-release": "^25.0.3",
    "tsx": "4.22.1",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
